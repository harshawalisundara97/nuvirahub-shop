<?xml version="1.0"?>
<ruleset name="nuvira-shop">
    <description>WordPress Coding Standards for the nuvira-shop theme.</description>

    <file>theme-src</file>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress"/>

    <config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
